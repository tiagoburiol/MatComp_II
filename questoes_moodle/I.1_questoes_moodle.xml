<!-- question: I1_Q1_angulo_entre_vetores -->
  <question type="multichoice">
    <name>
      <text>I1_Q1_angulo_entre_vetores</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Considere os vetores <strong>u = (2, -1, 3)</strong> e <strong>v = (1, 4, -2)</strong>. Usando <code>numpy</code> (produto escalar, norma e <code>np.arccos</code>), calcule o ângulo entre <strong>u</strong> e <strong>v</strong>, em graus. Qual é o valor mais próximo do ângulo obtido?</p>]]></text>
    </questiontext>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<p>118&deg;</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>62&deg;</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>90&deg;</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>34&deg;</p>]]></text>
    </answer>
  </question>

