      <text><![CDATA[<p>0,9809</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>1,0000</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>-0,9809</p>]]></text>
