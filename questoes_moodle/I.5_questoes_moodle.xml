    <answer fraction="100" format="html">
      <text><![CDATA[<p>0,25</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>0,5</p>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<p>4,0</p>]]></text>
    </answer>
